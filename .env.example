# Copy this file to .env and adjust for your instance.
# For remote access, use your exact HTTPS hostname for RP_ID and ORIGIN.
RP_ID=localhost
ORIGIN=http://localhost:8080
WEB_PORT=8080
RP_NAME=openGym

# Optional: comma-separated user IDs allowed to use the admin dashboard.
ADMIN_UIDS=

# Set to 1 to require invite codes for new profiles.
INVITE_ONLY=0

# Optional overrides; defaults are safe for a local instance.
# SESSION_DAYS=90
# VAPID_SUBJECT=mailto:admin@example.com
